{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sortorium POS",
  "version": "0.1.0",
  "identifier": "com.geekssort.sortorium.pos",
  "build": {
    "beforeDevCommand": "bash scripts/pre-dev.sh",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "Sortorium POS",
        "width": 1920,
        "height": 1080,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "sortorium-pos.desktop.hbs"
      },
      "rpm": {
        "desktopTemplate": "sortorium-pos.desktop.hbs"
      }
    },
    "macOS": {
      "bundleName": "Sortorium POS",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:sortorium.db"]
    }
  }
}
